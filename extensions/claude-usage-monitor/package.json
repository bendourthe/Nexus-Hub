{
  "name": "claude-usage-monitor",
  "displayName": "Claude Usage Monitor",
  "description": "Monitor your Claude Code usage limits and get smart model-switching recommendations",
  "version": "0.3.2",
  "publisher": "devai-hub",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claude-usage.dashboard",
        "title": "Claude Usage: Dashboard",
        "category": "Claude Usage"
      },
      {
        "command": "claude-usage.refresh",
        "title": "Claude Usage: Refresh",
        "category": "Claude Usage"
      },
      {
        "command": "claude-usage.recommend",
        "title": "Claude Usage: Recommend Model",
        "category": "Claude Usage"
      },
      {
        "command": "claude-usage.reset",
        "title": "Claude Usage: Clear Data",
        "category": "Claude Usage"
      },
      {
        "command": "claude-usage.settings",
        "title": "Claude Usage: Settings",
        "category": "Claude Usage"
      }
    ],
    "icons": {
      "claude-icon": {
        "description": "Claude AI icon",
        "default": {
          "fontPath": "./fonts/claude-icons.woff2",
          "fontCharacter": "\\E101"
        }
      }
    },
    "configuration": {
      "title": "Claude Usage Monitor",
      "properties": {
        "claudeUsage.autoFetch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically fetch usage data from Claude API on startup and at regular intervals"
        },
        "claudeUsage.refreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 120,
          "description": "How often (in minutes) to fetch usage data from the API"
        },
        "claudeUsage.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Claude usage in the status bar"
        },
        "claudeUsage.thresholds.moderate": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 99,
          "description": "Usage percentage at which the Moderate urgency level is triggered"
        },
        "claudeUsage.thresholds.high": {
          "type": "number",
          "default": 75,
          "minimum": 1,
          "maximum": 99,
          "description": "Usage percentage at which the High urgency level is triggered"
        },
        "claudeUsage.thresholds.critical": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 99,
          "description": "Usage percentage at which the Critical urgency level is triggered"
        },
        "claudeUsage.colors.moderate": {
          "type": "string",
          "default": "warning",
          "enum": ["warning", "error", "none"],
          "enumDescriptions": [
            "Yellow/orange highlight (statusBarItem.warningBackground)",
            "Red highlight (statusBarItem.errorBackground)",
            "No status bar highlight"
          ],
          "description": "Status bar background color when usage is at the Moderate level"
        },
        "claudeUsage.colors.high": {
          "type": "string",
          "default": "error",
          "enum": ["warning", "error", "none"],
          "enumDescriptions": [
            "Yellow/orange highlight (statusBarItem.warningBackground)",
            "Red highlight (statusBarItem.errorBackground)",
            "No status bar highlight"
          ],
          "description": "Status bar background color when usage is at the High level"
        },
        "claudeUsage.colors.critical": {
          "type": "string",
          "default": "error",
          "enum": ["warning", "error", "none"],
          "enumDescriptions": [
            "Yellow/orange highlight (statusBarItem.warningBackground)",
            "Red highlight (statusBarItem.errorBackground)",
            "No status bar highlight"
          ],
          "description": "Status bar background color when usage is at the Critical level"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "fantasticon": "^4.1.0",
    "svg2ttf": "^6.0.3",
    "svgpath": "^2.6.0",
    "ttf2woff2": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
