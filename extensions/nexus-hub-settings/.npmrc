# Supply-chain policy for this extension's npm surface.
#
# save-exact: a new dependency is recorded at an EXACT version rather than a
# caret range, so `npm install <pkg>` cannot silently widen what a later resolve
# is allowed to pick. Existing caret ranges are unaffected; package-lock.json
# already pins what CI installs through `npm ci`.
#
# min-release-age: npm builds the tree from versions published more than N DAYS
# ago (unit verified 2026-08-25 against https://docs.npmjs.com/cli/v11/using-npm/config/,
# which documents the type as "null or Number" and the unit as days). Two days is
# the window in which a compromised release is most often caught and unpublished,
# and it costs nothing but same-day upgrades. Requires npm 11.10.0 or newer;
# older npm ignores the key with a warning rather than failing.
#
# It cannot break CI. Verified 2026-08-25 against
# https://docs.npmjs.com/cli/v11/commands/npm-ci/: `npm ci` installs strictly from
# package-lock.json and does not re-resolve versions, and min-release-age is not
# among the config options that page lists as affecting it. This setting therefore
# shapes future `npm install <pkg>` resolution only, never the pinned CI install.
save-exact=true
min-release-age=2
