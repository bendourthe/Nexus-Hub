{
  "_description": "Google Gemini CLI auto-approve permissions for safe, read-only operations. Merged into ~/.gemini/settings.json during installation. See trusted-domains.json for the domain allowlist.",

  "tools": {
    "allowed": [
      "ReadFileTool",
      "ListFilesTool",
      "code_search",
      "web_search",

      "run_shell_command(ls)",
