{
  "meta": {
    "last_verified": "2026-07-19",
    "verified_for_version": "3.14.7",
    "description": "Machine-readable single source for the platform read-contract guards. The human-readable surface table, formats, and source URLs live alongside in platform-read-contracts.md. Consumed by: scripts/verify_platform_contracts.py (contract_checks, code-vs-contract), scripts/lib/integrations/runner.py _verify_checks (install_verify, install-vs-reality), and scripts/check_platform_contract_freshness.py (meta, the release freshness gate). Re-verified against each platform's current docs and re-stamped (last_verified + verified_for_version) at every /update release by the platform-contract-verification skill.",
    "path_tokens": "In install_verify paths, '~/' resolves to the user home and '{project}/' resolves to the workspace/target root."
  },
  "contract_checks": {
    "codex": {
      "config": { "global_dir": "~/.codex" },
      "flatten": "override",
      "doc_mentions": ["~/.codex/skills", "~/.agents/skills", "~/.codex/prompts", "~/.codex/AGENTS.md"]
    },
    "antigravity2": {
      "config": { "global_dir": "~/.gemini/config" },
      "flatten": "override",
      "doc_mentions": ["~/.gemini/config/skills", "~/.gemini/config/global_workflows", "~/.gemini/GEMINI.md", "~/.gemini/antigravity-cli"]
    },
    "claude": {
      "config": { "global_dir": "~/.claude" },
      "flatten": "flag",
      "doc_mentions": ["~/.claude/skills"]
    },
    "gemini": {
      "config": { "global_dir": "~/.gemini" },
      "flatten": "flag",
      "doc_mentions": ["~/.gemini/skills"]
    },
    "gemini-cli": {
      "config": { "global_dir": "~/.gemini" },
      "flatten": "flag",
      "doc_mentions": ["~/.gemini/skills"]
    },
    "opencode": {
      "config": { "global_dir": "~/.config/opencode" },
      "flatten": "flag",
      "doc_mentions": ["~/.config/opencode/skills"]
    },
    "nexus-ai": {
      "config": { "global_dir": "~/.nexus-ai/catalog" },
      "flatten": "flag",
      "doc_mentions": ["~/.nexus-ai/catalog/skills"]
    }
  },
  "install_verify": [
    {
      "label": "Claude",
      "detect": ["~/.claude"],
      "remediation": "re-run the installer (Claude block)",
      "surfaces": [
        { "label": "commands", "kind": "nonempty_dir", "path": "~/.claude/commands" },
        { "label": "skills", "kind": "nonempty_dir", "path": "~/.claude/skills" },
        { "label": "CLAUDE.md SKILL_INDEX", "kind": "file_contains", "path": "~/.claude/CLAUDE.md", "needle": "Skill Index" }
      ]
    },
    {
      "label": "Codex / ChatGPT",
      "detect": ["~/.codex"],
      "remediation": "re-run the installer with --platforms codex",
      "surfaces": [
        { "label": "skills", "kind": "nonempty_dir", "path": "~/.codex/skills" },
        { "label": "~/.agents/skills", "kind": "nonempty_dir", "path": "~/.agents/skills" },
        { "label": "prompts", "kind": "nonempty_dir", "path": "~/.codex/prompts" },
        { "label": "AGENTS.md SKILL_INDEX", "kind": "file_contains", "path": "~/.codex/AGENTS.md", "needle": "Skill Index" }
      ]
    },
    {
      "label": "Gemini IDE",
      "detect": ["~/.gemini"],
      "remediation": "re-run the installer with --platforms gemini",
      "surfaces": [
        { "label": "skills", "kind": "nonempty_dir", "path": "~/.gemini/skills" },
        { "label": "workflows", "kind": "nonempty_dir", "path": "~/.gemini/workflows" },
        { "label": "GEMINI.md", "kind": "is_file", "path": "~/.gemini/GEMINI.md" }
      ]
    },
    {
      "label": "Antigravity 2.0 IDE (global)",
      "detect": ["~/.gemini/config", "~/.gemini/antigravity-cli"],
      "remediation": "re-run the installer with --platforms antigravity2",
      "surfaces": [
        { "label": "skills", "kind": "nonempty_dir", "path": "~/.gemini/config/skills" },
        { "label": "global_workflows", "kind": "nonempty_dir", "path": "~/.gemini/config/global_workflows" },
        { "label": "GEMINI.md", "kind": "is_file", "path": "~/.gemini/GEMINI.md" }
      ]
    },
    {
      "label": "Antigravity 2.0 CLI (agy)",
      "detect": ["~/.gemini/config", "~/.gemini/antigravity-cli"],
      "remediation": "re-run the installer with --platforms antigravity2",
      "surfaces": [
        { "label": "skills", "kind": "nonempty_dir", "path": "~/.gemini/antigravity-cli/skills" }
      ]
    },
    {
      "label": "Antigravity 2.0 (this project .agents/)",
      "detect": ["~/.gemini/config", "~/.gemini/antigravity-cli"],
      "remediation": "run `nexus-hub init` in this project for project-scoped .agents/ workflows",
      "surfaces": [
        { "label": "workflows", "kind": "nonempty_dir", "path": "{project}/.agents/workflows" }
      ]
    },
    {
      "label": "Cursor",
      "detect": ["~/.cursor"],
      "remediation": "re-run the installer with --platforms cursor",
      "surfaces": [
        { "label": "commands", "kind": "nonempty_dir", "path": "~/.cursor/commands" }
      ]
    },
    {
      "label": "OpenCode",
      "detect": ["~/.config/opencode", "~/.opencode"],
      "remediation": "re-run the installer with --platforms opencode",
      "surfaces": [
        { "label": "skills", "kind": "nonempty_dir", "path": "~/.config/opencode/skills" },
        { "label": "AGENTS.md", "kind": "is_file", "path": "~/.config/opencode/AGENTS.md" }
      ]
    }
  ]
}
