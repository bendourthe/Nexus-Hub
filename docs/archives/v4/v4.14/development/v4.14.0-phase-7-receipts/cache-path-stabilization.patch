+@pytest.mark.skipif(sys.platform != "win32", reason="Windows long cache privacy boundaries")
+@pytest.mark.parametrize("boundary", ["git-file", "git-directory", "workspace", "sync"])
+@pytest.mark.parametrize("extended_alias", [False, True])
+def test_long_cache_refuses_private_copy_destinations(tmp_path, monkeypatch, boundary, extended_alias):
+    import runpy
+
+    helper = runpy.run_path(str(_HELPER))
+    parent = tmp_path
+    while len(str(parent)) < 280:
+        parent /= "long-private-boundary"
+    access = Path("\\\\?\\" + str(parent))
+    access.mkdir(parents=True)
+    if boundary == "git-file":
+        (access / ".git").write_text("gitdir: other\n", encoding="utf-8")
+    elif boundary == "git-directory":
+        (access / ".git").mkdir()
+    elif boundary == "workspace":
+        monkeypatch.chdir(tmp_path)
+    else:
+        monkeypatch.setenv("OneDrive", str(access if extended_alias else parent))
+    cache = parent / "cache"
+    cache_access = access / "cache"
+    monkeypatch.setenv("NEXUS_EDIT_GUARD_DIR", str(cache_access if extended_alias else cache))
+    with pytest.raises(helper["GuardError"], match="refusing a store inside"):
+        helper["store_dir"]()
+    assert not cache_access.exists(), "refused store created private cache directories"
+
