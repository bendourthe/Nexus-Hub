+def test_cache_repository_probe_error_refuses_before_creating_copies(tmp_path, monkeypatch):
+    import runpy
+
+    helper = runpy.run_path(str(_HELPER))
+    cache = tmp_path / "cache"
+    monkeypatch.setenv("NEXUS_EDIT_GUARD_DIR", str(cache))
+    original = Path.stat
+
+    def denied_marker(path, *args, **kwargs):
+        if path.name == ".git":
+            raise PermissionError("private marker cannot be inspected")
+        return original(path, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "stat", denied_marker)
+    with pytest.raises(helper["GuardError"], match="cannot verify store repository exclusion"):
+        helper["store_dir"]()
+    assert not cache.exists(), "unverified store created private cache directories"
