{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus-hub/training-story.schema.json",
  "title": "Training story",
  "description": "The single source for the Training page's stages, sessions, files, and model badges (v4.13.10). Rendering, the tracker, the outline, and the tests all read this data.",
  "type": "object",
  "required": [
    "version",
    "project",
    "defaultProvider",
    "providers",
    "stages"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "defaultProvider": {
      "enum": [
        "Anthropic",
        "OpenAI",
        "Google",
        "Cursor"
      ]
    },
    "providers": {
      "type": "array",
      "items": {
        "enum": [
          "Anthropic",
          "OpenAI",
          "Google",
          "Cursor"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "banner": {
      "type": "object",
      "required": [
        "step",
        "title",
        "now"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "now": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "badge": {
      "type": "object",
      "required": [
        "tier",
        "effort",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": [
            "frontier",
            "strong",
            "standard",
            "fast"
          ]
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "max"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "intro",
            "play",
            "session"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "play"
              }
            }
          },
          "then": {
            "required": [
              "game",
              "banner",
              "callout",
              "after"
            ],
            "properties": {
              "id": {
                "pattern": "^play-"
              },
              "game": {
                "enum": [
                  "buggy",
                  "partial",
                  "fixed"
                ]
              },
              "banner": {
                "$ref": "#/$defs/banner"
              },
              "callout": {
                "type": "object",
                "required": [
                  "title",
                  "items"
                ],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "$ref": "#/$defs/text"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/text"
                    }
                  },
                  "hidden": {
                    "$ref": "#/$defs/text"
                  },
                  "tone": {
                    "enum": [
                      "warn",
                      "ok"
                    ]
                  }
                }
              },
              "after": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "session"
              }
            }
          },
          "then": {
            "required": [
              "loop",
              "step",
              "banner",
              "badge",
              "prompt",
              "steps",
              "reply"
            ],
            "properties": {
              "id": {
                "pattern": "^loop[12]/(describe|review|plan|implement|test|update)$"
              },
              "loop": {
                "enum": [
                  1,
                  2
                ]
              },
              "step": {
                "enum": [
                  "describe",
                  "review",
                  "plan",
                  "implement",
                  "test",
                  "update"
                ]
              },
              "banner": {
                "$ref": "#/$defs/banner"
              },
              "badge": {
                "$ref": "#/$defs/badge"
              },
              "prompt": {
                "$ref": "#/$defs/prompt"
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/step"
                }
              },
              "reply": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "prompt": {
      "type": "object",
      "required": [
        "command",
        "argument"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "pattern": "^/[a-z-]+$"
        },
        "argument": {
          "type": "string"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "kind",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "read",
            "search",
            "think",
            "write",
            "edit",
            "run"
          ]
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "write",
                  "edit"
                ]
              }
            }
          },
          "then": {
            "required": [
              "file",
              "content"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "read"
              }
            }
          },
          "then": {
            "required": [
              "file"
            ]
          }
        }
      ]
    }
  }
}
