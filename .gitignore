# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Claude Code settings (root only)
# Note: CLAUDE.md and .github/copilot-instructions.md are now tracked repo-scoped
# pointer files (v0.9.7+) documenting installer-aware contribution rules.
/.claude/
settings.local.json

# Temporary working directory
temp/

# Python caches (pytest, mypy, ruff) - not covered by *.py[cod]
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python coverage artifacts (added in v2.2.0 when phase tests started running with --cov)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Python virtual environments (developer-local)
.venv/
venv/
env/

# VS Code extension build output
*.vsix
extensions/**/out/

# MCP benchmark output (v1.0.0+)
data/benchmarks/

# nexus-code-search local index (v1.0.0+; renamed from .devai/ at v2.0.0)
.nexus/
.nexusignore
# Legacy v1.x patterns retained for in-flight upgrades; safe to remove after v2.1.0
.devai/
.devaiignore

# Integration registry manifest written by scripts/lib/integrations/runner.py (v2.1.0+)
# into target install directories; should never appear inside the Nexus-Hub repo itself
# but listed defensively in case a developer runs the runner with --target=. during testing.
.nexus-hub/install-manifest.json
.nexus-hub/

# Bring-your-own-key media config written by `nexus-hub setup-media` (v3.14.3).
# It is always written under ~/.nexus-hub/config/media.env (outside any repo);
# listed defensively so a stray in-repo copy (e.g. a mis-scoped test run) can
# never be committed - it holds a Pexels API key.
media.env

# skill-eval-loop user workspaces (v1.2.0-wip / Phase 5). Users running the
# eval loop produce <skill-name>-workspace/ directories at the repo root with
# per-iteration outputs, benchmarks, and feedback. Ignore them so iteration
# artifacts do not leak into commits. Pattern matches the convention from
# catalog/skills/workflow/skill-eval-loop/SKILL.md step 1.
*-workspace/

# .skill archives produced by scripts/package_skill.py (v1.2.0 / Phase 7 / A16).
# These are portable ZIP archives intended for upload to Claude.ai or the
# Anthropic API skill-upload endpoint - they should not land in the catalog
# tree. Default output path is ./<skill-name>.skill in the current directory.
*.skill

# Antigravity CLI local runtime dir (created on use; never committed)
.antigravitycli/

# Atomic-write scratch files from `validate_unicode_safety.py --fix` (v3.16.8
# Phase 1). The fixer writes `.<filename>.<random>.tmp` beside its target and
# renames over it, unlinking the temp file on any error, so one survives only an
# abnormal termination (SIGKILL, power loss). Ignored so a stray leftover can
# never be swept into a commit by `git add -A`.
.*.tmp

# Windows PowerShell profile scaffolding created as a side effect of the
# installer and hook test suites, which invoke powershell.exe with the repo as
# CWD (v3.18.0 Phase 5). Git does not track empty directories, so this tree is
# invisible to `git status` while still being real enough to abort a
# `git stash -u` with "failed to remove ...: Permission denied" on a
# OneDrive-synced checkout. Ignored so it can never be committed if a run does
# leave a file in it.
/Microsoft/

# Looping SKILL.md relocator incident (2026-08-23). Numbered stubs under
# ai-agent-development/references/ are never catalog content.
catalog/skills/ai-development/ai-agent-development/references/references.md
catalog/skills/ai-development/ai-agent-development/references/references-[0-9]*.md

# Repository-native CI engine output (v4.0.0). scripts/ci/run.py writes here on
# every local run; the artifacts are per-run evidence, never source.
/reports/

# v4.4.3: the declared browser matrix's screenshots are regenerable evidence and are not committed.
# The per-run summary JSON beside them IS committed and is the authoritative record. See
# docs/releases/v4/v4.4/development/guide-illustration-clarity-rebuild/renders/README.md
docs/releases/v4/v4.4/development/guide-illustration-clarity-rebuild/renders/**/*.png
