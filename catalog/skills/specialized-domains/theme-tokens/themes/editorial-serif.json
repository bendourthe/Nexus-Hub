  "description": "Long-form magazine layout; serif heading paired with high-contrast body for whitepapers and design-doc PDFs.",
  "palette": {
    "primary": "#1a1a1a",
    "secondary": "#3d3d3d",
    "accent": "#a83232",
    "background": "#fbf9f4",
    "foreground": "#101010",
    "muted": "#6b6b6b"
  },
  "fonts": {
    "heading": "'EB Garamond', 'Cormorant Garamond', Georgia, serif",
    "body": "'EB Garamond', Georgia, serif",
    "mono": "'JetBrains Mono', 'IBM Plex Mono', ui-monospace, monospace"
  },
  "spacing": {
    "base": 8,
    "scale": [0.5, 1, 1.5, 2, 3, 4, 6, 8]
  },
  "radius": 2,
  "shadow": "none"
}
